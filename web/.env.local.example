# Pengaturan server lokal Zuno Web. Salin file ini menjadi ".env.local" (di folder web), lalu isi.
# ".env.local" tidak ikut ke GitHub. Jangan tempel isinya ke chat atau tempat umum.

# Kunci akses halaman: karangan sendiri, acak, minimal 16 karakter.
# Nanti dimasukkan lewat tombol KUNCI AKSES di halaman.
ZUNO_ACCESS_KEY=

# Penyedia AI: gemini | openrouter | claude | openai | openai-compatible
AI_PROVIDER=gemini

# Isi key penyedia yang dipilih (cukup satu):
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Opsional: nama model tetap (kosong = otomatis) dan port lokal.
AI_MODEL=
PORT=3000
