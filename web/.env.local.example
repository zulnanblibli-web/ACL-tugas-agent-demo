# Pengaturan server Nexaoffice (laptop atau VPS). Salin file ini menjadi ".env.local" di folder yang sama, lalu isi.
# ".env.local" tidak ikut ke GitHub. Jangan tempel isinya ke chat atau tempat umum.

# Kunci akses halaman: karangan sendiri, acak, minimal 16 karakter.
# Nanti dimasukkan lewat menu Pengaturan AI di halaman.
ZUNO_ACCESS_KEY=

# Penyedia AI: gemini | openrouter | claude | openai | openai-compatible
AI_PROVIDER=gemini

# Isi key penyedia yang dipilih (cukup satu):
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Opsional: nama model tetap (kosong = otomatis) dan port lokal.
AI_MODEL=
PORT=3000

# Opsional: riset web Peneliti Tren (Google Trends, Google News, Hacker News; tanpa API key).
# RISET_AKTIF=off untuk mematikan. Kosong = bawaan.
RISET_AKTIF=
RISET_SUMBER=trends,news,hn
RISET_NEGARA=ID
RISET_BAHASA=id
# Kata kunci niche yang selalu ikut dicari, pisahkan dengan |  (mis. AI agent|produk digital)
RISET_KATA_KUNCI=
RISET_HARI_BERITA=7
RISET_HARI_DISKUSI=14
# Cover slide 1 carousel dari gambar sumber berita / foto Wikimedia. off = pakai foto bawaan saja.
RISET_GAMBAR=

# ---------- Server VPS / menu Pengaturan AI ----------
# Alamat dengar. Di VPS biarkan 127.0.0.1 (Caddy yang menerima dari luar lewat HTTPS).
HOST=127.0.0.1
# Label server di /api/status (pasang-vps.sh mengisi "vps").
NEXA_SERVER=
# Situs lain yang boleh memakai server ini dari menu Pengaturan AI > Server VPS (pisahkan koma),
# mis. https://zuno-studio-dusky.vercel.app
NEXA_CORS_ORIGIN=
# off = tolak API key yang dikirim dari halaman (mode "API key lokal"). Kosong = boleh.
NEXA_KUNCI_PENGGUNA=
# Khusus penyedia openai-compatible (9router, Ollama, LM Studio):
AI_BASE_URL=
AI_API_KEY=
